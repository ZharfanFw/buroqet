// Pipeline Dispatch Fleet Service — Jalankan sebagai Jenkins job terpisah.
// Script path di job: dispatch-fleet/Jenkinsfile

pipeline {
    agent any

    environment {
        SERVICE_DIR       = 'dispatch-fleet-service'
        DOCKER_HUB_USER   = 'imamaziz'
        DOCKER_HUB_ID     = 'docker-hub-credentials'
        IMAGE_NAME        = 'dispatch-fleet'
    }

    stages {
        stage('Checkout Repository') {
            steps {
                echo '=== Checkout: logistics-system (Dispatch Fleet) ==='
                checkout scm
            }
        }

        stage('Unit Test') {
            steps {
                echo '=== Unit Test: Dispatch Fleet Service ==='
                dir("${SERVICE_DIR}") {
                    bat 'go mod tidy'
                    bat 'go test -v -count=1 ./internal/...'
                }
            }
        }

        stage('Lint') {
            steps {
                echo '=== Lint: Dispatch Fleet Service ==='
                dir("${SERVICE_DIR}") {
                    bat 'go vet ./internal/...'
                }
            }
        }

        stage('Build Image') {
            steps {
                echo '=== Build Docker Image: Dispatch Fleet Service ==='
                dir("${SERVICE_DIR}/deployments") {
                    withCredentials([usernamePassword(
                        credentialsId: "${DOCKER_HUB_ID}",
                        passwordVariable: 'DOCKER_PASS',
                        usernameVariable: 'DOCKER_USER'
                    )]) {
                        bat 'docker login -u %DOCKER_USER% -p %DOCKER_PASS%'
                        bat 'docker build -t imamaziz/dispatch-fleet-service:latest -f Dockerfile ..'
                    }
                }
            }
        }

        stage('Functional Test') {
            steps {
                echo '=== Functional Test: Dispatch Fleet Service ==='
                bat "docker-compose -f ${SERVICE_DIR}/deployments/docker-compose.test.yml up -d"
                bat 'C:\\Windows\\System32\\ping.exe -n 16 127.0.0.1'
                bat 'set TEST_DATABASE_URL=host=localhost user=user password=pass dbname=database_ngasal_biar_gagal port=5433 sslmode=disable&&go test -v -tags=functional -count=1 ../tests/functional/...'
            }
            post {
                always {
                    dir("${SERVICE_DIR}/deployments") {
                        bat 'docker-compose -f docker-compose.test.yml down -v'
                    }
                }
            }
        } // Di sini stage Functional Test baru ditutup dengan benar

        stage('Push Image') {
            steps {
                echo '=== Push Image: Dispatch Fleet Service ==='
                withCredentials([usernamePassword(
                    credentialsId: "${DOCKER_HUB_ID}",
                    passwordVariable: 'DOCKER_PASS',
                    usernameVariable: 'DOCKER_USER'
                )]) {
                    bat 'docker login -u %DOCKER_USER% -p %DOCKER_PASS%'
                    bat "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '=== Deploy Dispatch Fleet ke Kubernetes ==='
                bat "kubectl --kubeconfig=C:\\Users\\Lenovo\\.kube\\config apply -f ${SERVICE_DIR}/deployments/kubernetes/"
            }
        }

        stage('Verify Deployment') {
            steps {
                echo '=== Verifikasi Deployment Dispatch Fleet ==='
                bat "kubectl --kubeconfig=C:\\Users\\Lenovo\\.kube\\config get pods -l app=dispatch-fleet"
                bat "kubectl --kubeconfig=C:\\Users\\Lenovo\\.kube\\config get svc -l app=dispatch-fleet"
            }
        }
    }

    post {
        success {
            echo 'Pipeline Dispatch Fleet Service berhasil.'
        }
        failure {
            echo 'Pipeline Dispatch Fleet Service gagal. Periksa log unit/functional test.'
        }
    }
}