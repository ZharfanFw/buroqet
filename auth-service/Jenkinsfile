pipeline {
    agent any

    environment {
        SERVICE_DIR       = 'auth-service'
        DOCKER_HUB_USER   = 'imamaziz'
        DOCKER_HUB_ID     = 'docker-hub-credentials'
        IMAGE_NAME        = 'auth-service'
    }

    stages {
        stage('Checkout Repository') {
            steps {
                echo '=== Checkout: logistics-system (Auth Service) ==='
                git branch: 'imam',
                    url: 'https://github.com/MahendraDevid/logistics-system.git'
            }
        }

        stage('Unit Test') {
            steps {
                echo '=== Unit Test: Auth Service ==='
                dir("${SERVICE_DIR}") {
                    bat 'go mod tidy'
                    bat 'go test -v -count=1 ./internal/...'
                }
            }
        }

        stage('Lint') {
            steps {
                echo '=== Lint: Auth Service ==='
                dir("${SERVICE_DIR}") {
                    bat 'go vet ./...'
                }
            }
        }

        stage('Build Image') {
            steps {
                echo '=== Build Docker Image: Auth Service ==='
                dir("${SERVICE_DIR}") {
                    withCredentials([usernamePassword(
                        credentialsId: "${DOCKER_HUB_ID}",
                        passwordVariable: 'DOCKER_PASS',
                        usernameVariable: 'DOCKER_USER'
                    )]) {
                        bat 'docker login -u %DOCKER_USER% -p %DOCKER_PASS%'
                        bat "docker build -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest -f Dockerfile ."
                    }
                }
            }
        }

        stage('Functional Test') {
            steps {
                echo '=== Functional Test: Auth Service ==='
                // Kita paksa docker-compose menunjuk folder yang super akurat
                bat "docker-compose -f ${SERVICE_DIR}/docker-compose.test.yml up -d"
                
                bat 'C:\\Windows\\System32\\ping.exe -n 16 127.0.0.1'
                
                // Jalankan test tepat di dalam folder auth-service agar go test gak nyasar
                dir("${SERVICE_DIR}") {
                    bat 'set TEST_DATABASE_URL=host=localhost user=postgres password=password dbname=postgres port=5433 sslmode=disable&&go test -v -tags=functional -count=1 ./tests/functional/...'
                }
            }
            post {
                always {
                    dir("${SERVICE_DIR}") {
                        bat "docker-compose -f docker-compose.test.yml down -v"
                    }
                 
                    // Jalur pembersihan juga pakai absolute path service
                }
            }
        }

        stage('Push Image') {
            steps {
                echo '=== Push Image: Auth Service ==='
                withCredentials([usernamePassword(
                    credentialsId: "${DOCKER_HUB_ID}",
                    passwordVariable: 'DOCKER_PASS',
                    usernameVariable: 'DOCKER_USER'
                )]) {
                    bat 'docker login -u %DOCKER_USER% -p %DOCKER_PASS%'
                    bat "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '=== Deploy Auth Service ke Kubernetes ==='
                bat "kubectl --kubeconfig=C:\\Users\\Lenovo\\.kube\\config apply -f ${SERVICE_DIR}/deployments/kubernetes/"
            }
        }

        stage('Verify Deployment') {
            steps {
                echo '=== Verifikasi Deployment Auth ==='
                bat "kubectl --kubeconfig=C:\\Users\\Lenovo\\.kube\\config get pods -l app=auth-service"
                bat "kubectl --kubeconfig=C:\\Users\\Lenovo\\.kube\\config get svc -l app=auth-service"
            }
        }
    }

    post {
        success {
            echo 'Pipeline Auth Service berhasil.'
        }
        failure {
            echo 'Pipeline Auth Service gagal. Periksa log unit/functional test.'
        }
    }
}